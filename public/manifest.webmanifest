{
  "name": "Sift — catch up on chats, privately",
  "short_name": "Sift",
  "description": "Surfaces the mentions, deadlines, decisions and tasks hidden in your chats. Everything runs on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "chat", "accept": ["text/plain", ".txt", "application/zip", ".zip", "application/json", ".json"] }]
    }
  }
}
